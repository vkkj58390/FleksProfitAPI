  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FleksProfitAPI\FleksProfitAPI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>
